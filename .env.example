# Environment reference for CI and process managers. CodeFarmer does not load
# .env files automatically. Export these values before starting the CLI, and
# never commit a real key.
OPENAI_API_KEY=sk-your-key-here
# Select one provider and set its key. Supported: openai, gemini, grok, deepseek, kimi.
CODEFARMER_PROVIDER=openai
# GEMINI_API_KEY=...
# XAI_API_KEY=...
# DEEPSEEK_API_KEY=...
# MOONSHOT_API_KEY=...

# Optional runtime overrides. CLI flags take precedence over these values.
CODEFARMER_MODEL=gpt-5.6-sol
CODEFARMER_BASE_URL=https://api.openai.com/v1
CODEFARMER_REASONING=medium
CODEFARMER_APPROVAL=ask
CODEFARMER_STREAM=true
CODEFARMER_STORE=true
CODEFARMER_LOG_LEVEL=info
CODEFARMER_MAX_AGENT_TURNS=25
CODEFARMER_MAX_FILE_SIZE_BYTES=1048576
CODEFARMER_MAX_TOOL_OUTPUT_BYTES=102400
CODEFARMER_COMMAND_TIMEOUT_MS=120000
# Accepts a JSON string array or comma-separated patterns.
CODEFARMER_IGNORED_PATHS=[".git/**","node_modules/**","dist/**"]
