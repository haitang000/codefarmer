{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefarmer.dev/schemas/codefarmer.config.schema.json",
  "title": "CodeFarmer configuration",
  "description": "Project or user configuration for the CodeFarmer CLI. API keys must be supplied through OPENAI_API_KEY and cannot be stored here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "model": { "type": "string", "minLength": 1, "default": "gpt-5.6-sol" },
    "baseURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^?#]+$",
      "default": "https://api.openai.com/v1",
      "description": "OpenAI-compatible API base URL without credentials, query, or fragment."
    },
    "reasoning": {
      "type": "string",
      "enum": ["auto", "none", "low", "medium", "high", "xhigh", "max"],
      "default": "medium",
      "description": "Reasoning effort; 'auto' lets the model decide its own thinking depth."
    },
    "approval": {
      "type": "string",
      "enum": ["ask", "auto", "read-only"],
      "default": "ask"
    },
    "stream": { "type": "boolean", "default": true },
    "store": {
      "type": "boolean",
      "const": true,
      "default": true,
      "description": "CodeFarmer v1 requires server-side response state for previous_response_id continuation."
    },
    "logLevel": {
      "type": "string",
      "enum": ["trace", "debug", "info", "warn", "error", "fatal", "silent"],
      "default": "info"
    },
    "maxAgentTurns": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
    "maxFileSizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600,
      "default": 1048576
    },
    "maxToolOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760,
      "default": 102400
    },
    "commandTimeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000,
      "default": 120000
    },
    "ignoredPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 1000,
      "uniqueItems": true
    }
  }
}
