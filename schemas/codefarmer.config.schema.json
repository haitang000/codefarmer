{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefarmer.dev/schemas/codefarmer.config.schema.json",
  "title": "CodeFarmer configuration",
  "description": "Project or user configuration for the CodeFarmer CLI. Provider API keys are supplied through environment variables or the local credentials file and cannot be stored here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "language": {
      "type": "string",
      "enum": ["en", "zh-CN"],
      "default": "en",
      "description": "Interface and agent response language."
    },
    "provider": {
      "type": "string",
      "enum": ["openai", "gemini", "grok", "deepseek", "kimi"],
      "default": "openai"
    },
    "model": { "type": "string", "minLength": 1, "default": "gpt-5.6-sol" },
    "baseURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^?#]+$",
      "default": "https://api.openai.com/v1",
      "description": "OpenAI-compatible API base URL without credentials, query, or fragment."
    },
    "reasoning": {
      "type": "string",
      "enum": ["auto", "none", "low", "medium", "high", "xhigh", "max"],
      "default": "high",
      "description": "Reasoning effort. Defaults to high for deeper thinking; lower levels reduce reasoning and completion tokens."
    },
    "verbosity": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "low",
      "description": "Text response detail level. Lower values reduce output tokens."
    },
    "reasoningSummary": {
      "type": "string",
      "enum": ["none", "auto", "concise", "detailed"],
      "default": "none",
      "description": "Visible reasoning summary detail. 'none' omits summaries and reduces output tokens."
    },
    "approval": {
      "type": "string",
      "enum": ["ask", "auto", "read-only"],
      "default": "ask"
    },
    "stream": { "type": "boolean", "default": true },
    "store": {
      "type": "boolean",
      "const": true,
      "default": true,
      "description": "CodeFarmer v1 requires server-side response state for previous_response_id continuation."
    },
    "logLevel": {
      "type": "string",
      "enum": ["trace", "debug", "info", "warn", "error", "fatal", "silent"],
      "default": "info"
    },
    "maxAgentTurns": { "type": "integer", "minimum": 1, "maximum": 100, "default": 12 },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 128,
      "maximum": 100000,
      "default": 2048,
      "description": "Hard completion-token limit per model request, including reasoning tokens where the provider reports them."
    },
    "maxFileSizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600,
      "default": 1048576
    },
    "maxToolOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760,
      "default": 12288
    },
    "commandTimeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000,
      "default": 120000
    },
    "ignoredPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 1000,
      "uniqueItems": true
    }
  }
}
